# Codex: implement optional remote model download for free deployment.
MODEL_PATH=models/model.pth
HF_MODEL_REPO=
HF_MODEL_FILENAME=model.pth
MODEL_URL=
HF_MODEL_REVISION=main
# Optional but recommended: checksum of the published checkpoint
MODEL_SHA256=f8666134bbe97f0ce5dd292e0a9f9c983fccaa7a659aa3d9529b056fca678ccf
TORCH_NUM_THREADS=2
# auto recognizes the complete local checkpoint bundle; use cloud on Community Cloud.
DEPLOYMENT_MODE=auto
ENABLE_MODEL_COMPARISON=auto
# Keep false until actual hosted resource testing is recorded. Cloud also requires explicit true above.
HOSTED_COMPARISON_VERIFIED=false
COMPARISON_MODELS_DIR=models
# Optional public file repository; configuring it does not enable hosted comparison.
COMPARISON_HF_REPO=
COMPARISON_HF_REVISION=main
